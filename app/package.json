{
  "name": "jw-books",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "test:rules": "cd .. && npx -y firebase-tools@13.29.1 emulators:exec --only firestore --project demo-jw-rules 'node app/tests/rules/rules.test.mjs'",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "check": "tsc --noEmit && vitest run && vite build && node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
